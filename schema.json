{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catmoecircle.github.io/FuyuBot-plugins/schema.json",
  "title": "FuyuBot 插件商城索引",
  "type": "object",
  "required": ["schema", "plugins"],
  "properties": {
    "schema": { "const": 1 },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["id", "name", "repo", "latest", "versions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "license": { "type": "string" },
        "homepage": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "latest": { "type": "string" },
        "versions": { "type": "array", "items": { "$ref": "#/$defs/version" } }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": ["version", "assets"],
      "properties": {
        "version": { "type": "string" },
        "api": { "type": "string" },
        "abi": { "type": "integer", "minimum": 1 },
        "depends": { "type": "array", "items": { "type": "string" } },
        "yanked": { "type": "boolean" },
        "assets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/asset" }
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
